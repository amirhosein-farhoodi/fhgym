# Copy to .env.local and fill in. Never commit .env.local.
#
# Both values are safe to ship to the browser: the anon key is public by design and
# every table is protected by RLS. The service-role key must NEVER appear here — it
# belongs only in Supabase Edge Function secrets.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# --- server-side only, used by scripts/seed-exercises.ts. Keep out of the client bundle.
SUPABASE_SERVICE_ROLE_KEY=
